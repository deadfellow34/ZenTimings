<?xml version="1.0" encoding="utf-8"?>
<configuration>
<configSections>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
        <section name="ZenTimings.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false"/>
    </sectionGroup>
</configSections>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/></startup>
<!-- Access violations and invalid opcodes are corrupted-state exceptions, and by default the
     runtime never hands one to managed code - neither handler in App.xaml.cs fires and the
     process dies with no crash.txt. The benchmark can produce both: an AV through the assembled
     movntdq path, and #UD when VectorRead's 512-bit probe runs on a CPU without AVX-512. The
     probe is gated on IsProcessorFeaturePresent first, so this is its safety net rather than its
     mechanism - but do not remove the element on the strength of that. -->
<runtime><legacyCorruptedStateExceptionsPolicy enabled="true"/></runtime>
</configuration>
