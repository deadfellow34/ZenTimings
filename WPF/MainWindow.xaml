<local:ThemedAdonisWindow
    xmlns:local="clr-namespace:ZenTimings"
    x:Class="ZenTimings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    xmlns:converters="clr-namespace:ZenTimings.Converters"
    xmlns:controls="clr-namespace:ZenTimings.Controls"
    xmlns:loc="clr-namespace:ZenTimings.Localization"
    adonisExtensions:CursorSpotlightExtension.RelativeSpotlightSize="0"
    mc:Ignorable="d"
    Title="ZenTimings"
    Width="386"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanMinimize"
    FontSize="11"
    StateChanged="AdonisWindow_StateChanged"
    SizeChanged="AdonisWindow_SizeChanged"
    Activated="AdonisWindow_Activated"
    Loaded="AdonisWindow_Loaded"
    UseLayoutRounding="True"
    Style="{DynamicResource WindowStyles}"
    Closing="AdonisWindow_Closing"
    Height="538"
    SizeToContent="WidthAndHeight"
    Language="en-US">

    <!--Window.Style>
        <Style TargetType="Window" BasedOn="{StaticResource {x:Type Window}}"/>
    </Window.Style -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border>
        <StackPanel adonisExtensions:LayerExtension.Layer="0">
            <Border Style="{DynamicResource MainMenuStyles}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="3" />
                    </Grid.ColumnDefinitions>
                    <Menu x:Name="MainMenu" Grid.Column="0" Style="{DynamicResource MenuStyles}">
                        <MenuItem Header="{loc:Loc Menu.File}">
                            <MenuItem Header="{loc:Loc Menu.ExportHtml}" Click="ExportAsHtmlMenuItem_Click" />
                            <MenuItem Header="{loc:Loc Menu.ExportJson}" Click="ExportAsJsonMenuItem_Click" />
                            <MenuItem Header="{loc:Loc Menu.Exit}" Click="ExitToolStripMenuItem_Click" />
                            <!-- MenuItem Header="Export..." HorizontalAlignment="Left" Click="ExportToolStripMenuItem_Click" /-->
                        </MenuItem>
                        <MenuItem Header="{loc:Loc Menu.Tools}">
                            <MenuItem
                                Header="{loc:Loc Menu.DimmTelemetry}"
                                Click="TelemetryMonitorToolstripMenuItem_Click"
                                Visibility="{Binding IsDimmTelemetryAvailable, Mode=OneTime, Converter={StaticResource BoolToVis}}" />
                            <MenuItem
                                Header="{loc:Loc Menu.SpdInfo}"
                                Click="SpdInfoToolstripMenuItem_Click"
                                Visibility="{Binding IsDimmTelemetryAvailable, Mode=OneTime, Converter={StaticResource BoolToVis}}" />
                            <Separator
                                Foreground="{DynamicResource PanelBackground}"
                                Visibility="{Binding IsDimmTelemetryAvailable, Mode=OneTime, Converter={StaticResource BoolToVis}}"/>
                            <MenuItem
                                Header="{loc:Loc Menu.SystemInfo}"
                                Click="SystemInfoToolstripMenuItem_Click"
                                Visibility="{Binding Settings.AdvancedMode, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <MenuItem Header="{loc:Loc Menu.OcTools}" Click="OcToolsMenuItem_Click" />
                            <MenuItem Header="{loc:Loc Menu.MemoryLatency}" Click="MemoryLatencyMenuItem_Click" />
                            <MenuItem x:Name="LoggingMenuItem" Header="{loc:Loc Menu.StartLogging}" Click="LoggingMenuItem_Click" />
                            <MenuItem Header="{loc:Loc Menu.Options}" Click="OptionsToolStripMenuItem_Click" />
                            <MenuItem Header="{loc:Loc Menu.Debug}" Click="DebugToolstripItem_Click" />
                        </MenuItem>
                        <MenuItem Header="{loc:Loc Menu.Help}">
                            <MenuItem Header="{loc:Loc Menu.About}" Click="AboutToolStripMenuItem_Click" />
                            <MenuItem Header="{loc:Loc Menu.Changelog}" Click="MenuItem_Click_5" />
                            <Separator Foreground="{DynamicResource PanelBackground}" />
                            <MenuItem Header="Discord" Click="MenuItem_Click_2" />
                            <MenuItem Header="GitHub" Click="MenuItem_Click_3" />
                            <MenuItem Header="Google Drive" Click="MenuItem_Click_6" />
                            <Separator Foreground="{DynamicResource PanelBackground}" />
                            <MenuItem Header="Donate with _PayPal" Click="MenuItem_Click" />
                            <MenuItem Header="Donate with _Revolut" Click="MenuItem_Click_1" />
                            <Separator Foreground="{DynamicResource PanelBackground}" />
                            <MenuItem Header="AM5 AGESA/UEFI/BIOS List by Reous" Click="MenuItem_Click_4" />
                        </MenuItem>
                        <!-- Carries the profile list as its submenu. A top-level item with no
                             children falls onto a different control template than File/Tools/Help
                             and renders wider, with its own background. -->
                        <MenuItem x:Name="OcProfilesMenu" Header="{loc:Loc Menu.OcProfiles}" />
                    </Menu>

                    <Button Grid.Column="1"
                            Width="20"
                            Height="16"
                            BorderThickness="0"
                            Padding="0"
                            Style="{DynamicResource CameraButtonStyle}"
                            Click="ButtonScreenshot_Click"
                            ForceCursor="True"
                            Cursor="Hand">
                        <Image Source="{DynamicResource CameraImage}"
                               Height="16"
                               Width="16"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                    </Button>
                </Grid>
            </Border>

            <Border Style="{DynamicResource Separator}" />

            <!-- System Info Panel -->
            <Border Style="{DynamicResource PanelStyles}"
                    Visibility="{Binding Settings.AdvancedMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <!-- Logo and text share one cell so the grid measures max(text, logo) instead of
                     their sum. In its own column the logo added its full width to the window even
                     though the free space next to the shorter lines could hold it. -->
                <Grid>
                    <StackPanel Orientation="Vertical">
                        <TextBlock
                            x:Name="labelCPU"
                            Text="{Binding CpuNameShortWithCores, Mode=OneTime, FallbackValue='CPU: N/A'}"
                            Padding="12 5 5 0"
                        />
                        <TextBlock
                            x:Name="labelMB"
                            Text="{Binding MotherboardInfo, Mode=OneWay, FallbackValue='Motherboard: N/A'}"
                            Padding="12 0 5 5"
                        />
                        <TextBlock
                            x:Name="labelAgesaVersion"
                            Text="{Binding AgesaVersion, Mode=Default, FallbackValue='AGESA: N/A'}"
                            Visibility="{Binding IsAgesaVersionVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            Padding="12 0 5 5"
                            Margin="0 -5 0 0"
                        />

                        <!-- Live temperatures: CPU Die (Tctl/Tdie) and DDR5 memory (SPD hub).
                             Each readout carries a sparkline of its own recent history and a
                             min/max/avg tooltip. -->
                        <Border Padding="12 0 0 0"
                                Visibility="{Binding IsAnyReadoutVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Loc Main.CpuDie}"
                                           Padding="0 0 3 5"
                                           Visibility="{Binding IsCpuTemperatureVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <!-- MinWidth wide enough for the longest reading this can ever show
                                     ("100.0 °C" measures 47px at this font). Without it the row
                                     re-flows on every refresh, because the readings are not the
                                     same width: "8.0 °C" is 33px and "45.0 °C" is 40px. -->
                                <TextBlock Text="{Binding CpuTemperatureText, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           MinWidth="54"
                                           Padding="0 0 4 5"
                                           ToolTip="{Binding CpuTemperatureToolTip, Mode=OneWay}"
                                           Visibility="{Binding IsCpuTemperatureVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                                <!-- Average across the populated DIMMs, so the row keeps the same
                                     width whether one or four are fitted. Hovering lists each
                                     module separately. -->
                                <TextBlock Text="{loc:Loc Main.Memory}"
                                           Padding="0 0 3 5"
                                           Visibility="{Binding IsMemoryTemperatureVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding MemoryTemperatureText, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           MinWidth="54"
                                           Padding="0 0 4 5"
                                           ToolTip="{Binding MemoryTemperatureToolTip, Mode=OneWay}"
                                           Visibility="{Binding IsMemoryTemperatureVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                                <TextBlock Text="{loc:Loc Main.DimmPower}"
                                           Padding="0 0 3 5"
                                           Visibility="{Binding IsMemoryPowerVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding MemoryPowerText, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           MinWidth="52"
                                           Padding="0 0 4 5"
                                           ToolTip="Sum of the on-module PMIC power readings"
                                           Visibility="{Binding IsMemoryPowerVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                                <!-- Machine-check errors since boot. Sits with the temperatures
                                     because it is watched for the same reason: it is the first
                                     thing that moves when a memory overclock is not stable. -->
                                <TextBlock Text="{loc:Loc Main.Whea}"
                                           Padding="0 0 3 5"
                                           Visibility="{Binding IsWheaVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding WheaText, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           MinWidth="16"
                                           Padding="0 0 5 5"
                                           ToolTip="{Binding WheaToolTip, Mode=OneWay}"
                                           Visibility="{Binding IsWheaVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasWheaErrors, Mode=OneWay}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF6B6B" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border Padding="0 0 5 0" HorizontalAlignment="Right"
                            Visibility="{Binding IsMotherboardLogoVisible, Mode=OneTime, Converter={StaticResource BoolToVis}}">

                        <Button
                            BorderThickness="0"
                            Padding="0"
                            Style="{DynamicResource CameraButtonStyle}"
                            ForceCursor="True"
                            Cursor="Hand"
                            Click="MotherboardLinkButton_Click"
                            ToolTip="{Binding MotherboardLogoTooltip, Mode=OneTime}">
                            <Image
                               x:Name="motherboardLogoImage"
                               Height="40"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <Border Style="{DynamicResource Separator}"
                    Visibility="{Binding Settings.AdvancedMode, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

            <StackPanel x:Name="timingsPanelSlot" Margin="0" Orientation="Vertical" />

            <Border Style="{DynamicResource Separator}" />

            <Border Style="{DynamicResource BottomPanelStyles}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition>
                            <ColumnDefinition.Style>
                                <Style TargetType="ColumnDefinition">
                                    <Setter Property="Width" Value="280" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Settings.AdvancedMode}" Value="False">
                                            <Setter Property="Width" Value="240" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ColumnDefinition.Style>
                        </ColumnDefinition>
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="comboBoxPartNumber" IsReadOnly="True" Grid.Column="0" />
                    <StackPanel 
                        Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Visibility="{Binding Settings.AdvancedMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock
                            Text="ECC"
                            Style="{DynamicResource ValueStyles}"
                            Visibility="{Binding ECC, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            TextAlignment="Right"
                            Margin="0,0,5,0"
                            IsEnabled="False"
                            ToolTip="Error-Correcting Code memory detected"
                        />
                        <TextBlock
                            Text="{Binding MemoryType, FallbackValue=''}"
                            Style="{DynamicResource ValueStyles}"
                            TextAlignment="Right"
                            HorizontalAlignment="Right"
                            MinWidth="0"
                            Margin="0"
                            IsEnabled="False"
                        />
                    </StackPanel>

                    <!-- Button Grid.Column="1"
                            Width="20"
                            Height="16"
                            BorderThickness="0"
                            Padding="0"
                            Style="{DynamicResource CameraButtonStyle}"
                            ForceCursor="True"
                            Cursor="Hand"
                            Visibility="Hidden"
                            HorizontalAlignment="Right">
                        <Image Source="{DynamicResource WarningImage}"
                               Height="16"
                               Width="16"
                               Stretch="None"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Button-->
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</local:ThemedAdonisWindow>