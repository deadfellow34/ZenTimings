<local:ThemedAdonisWindow
    xmlns:local="clr-namespace:ZenTimings"
    xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
    x:Class="ZenTimings.Windows.OcProfilesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    mc:Ignorable="d"
    Title="OC Profiles"
    Height="620"
    Width="520"
    WindowStartupLocation="CenterOwner"
    BorderThickness="1"
    UseLayoutRounding="True"
    Style="{DynamicResource WindowStyles}"
    Icon="/ZenTimings;component/Resources/new-icon/16.png">

    <ScrollViewer Padding="0" Margin="0" HorizontalScrollBarVisibility="Disabled">
        <StackPanel CanVerticallyScroll="False">

            <GroupBox
                Header="Profile"
                adonisExtensions:LayerExtension.Layer="3"
                Padding="10 5">
                <StackPanel Orientation="Vertical">
                    <ComboBox
                        x:Name="ProfileSelector"
                        HorizontalAlignment="Stretch"
                        Margin="0 2 0 6"
                        DisplayMemberPath="Name"
                        SelectionChanged="ProfileSelector_SelectionChanged" />
                    <TextBlock x:Name="HardwareText" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource AccentTextColor}" Margin="0 0 0 2" />
                    <TextBlock x:Name="DiffSummary" FontSize="11" Opacity="0.8" />
                </StackPanel>
            </GroupBox>

            <ItemsControl x:Name="SectionList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Plain rows rather than a DataGrid: five grids in one window take long
                             enough to build that the window visibly lags behind the click, and
                             none of what a DataGrid brings (sorting, editing, virtualisation) is
                             wanted here. -->
                        <GroupBox
                            Header="{Binding Title}"
                            adonisExtensions:LayerExtension.Layer="3">
                            <StackPanel Margin="4 2">
                                <Grid Margin="0 0 0 3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="Profile" FontSize="11" Opacity="0.7" />
                                    <TextBlock Grid.Column="2" Text="This machine" FontSize="11" Opacity="0.7" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Timings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11"
                                                           Padding="0 1" Foreground="{DynamicResource TextColor}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11"
                                                           Padding="0 1" Foreground="{DynamicResource AccentTextColor}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Current}" FontSize="11"
                                                           Padding="0 1">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextColor}" />
                                                            <Setter Property="Opacity" Value="0.6" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDifferent}" Value="True">
                                                                    <Setter Property="Foreground" Value="#FF6B6B" />
                                                                    <Setter Property="Opacity" Value="1" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</local:ThemedAdonisWindow>
