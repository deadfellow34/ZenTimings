<local:ThemedAdonisWindow
    xmlns:local="clr-namespace:ZenTimings"
    xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
    x:Class="ZenTimings.Windows.MemoryLatencyWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    xmlns:loc="clr-namespace:ZenTimings.Localization"
    mc:Ignorable="d"
    Title="{loc:Loc Bench.Title}"
    Width="430"
    MinWidth="430"
    SizeToContent="Height"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner"
    BorderThickness="1"
    UseLayoutRounding="True"
    Style="{DynamicResource WindowStyles}"
    Icon="/ZenTimings;component/Resources/new-icon/16.png"
    Closing="Window_Closing">

    <!-- Scrolls because the history list makes this taller than a 768-line screen, and the
         window is capped to the work area in the code-behind. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
        <GroupBox
            Header="{loc:Loc Bench.Result}"
            adonisExtensions:LayerExtension.Layer="3"
            Padding="10 5">
            <StackPanel>
                <TextBlock x:Name="ResultText"
                           Text="-"
                           FontSize="30"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource AccentTextColor}" />
                <TextBlock x:Name="SpreadText"
                           Text="{loc:Loc Bench.NotMeasured}"
                           FontSize="11"
                           HorizontalAlignment="Stretch"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Opacity="0.7"
                           Margin="0 2 0 0" />

                <Grid Margin="0 8 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="{loc:Loc Bench.Read}" FontSize="11" Opacity="0.7" HorizontalAlignment="Center" />
                        <TextBlock x:Name="ReadText" Text="-" FontSize="15" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextColor}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="{loc:Loc Bench.Write}" FontSize="11" Opacity="0.7" HorizontalAlignment="Center" />
                        <TextBlock x:Name="WriteText" Text="-" FontSize="15" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextColor}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="{loc:Loc Bench.Copy}" FontSize="11" Opacity="0.7" HorizontalAlignment="Center" />
                        <TextBlock x:Name="CopyText" Text="-" FontSize="15" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextColor}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" HorizontalAlignment="Center"
                                ToolTip="{loc:Loc Bench.RandomTip}">
                        <TextBlock Text="{loc:Loc Bench.Random}" FontSize="11" Opacity="0.7" HorizontalAlignment="Center" />
                        <TextBlock x:Name="RandomText" Text="-" FontSize="15" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextColor}" />
                    </StackPanel>
                </Grid>

                <ProgressBar x:Name="Progress"
                             Height="4"
                             Margin="0 8 0 0"
                             Minimum="0" Maximum="1"
                             Visibility="Hidden" />
            </StackPanel>
        </GroupBox>

        <GroupBox
            Header="{loc:Loc Bench.Ceiling}"
            adonisExtensions:LayerExtension.Layer="3"
            Padding="10 5">
            <StackPanel x:Name="CeilingPanel" />
        </GroupBox>

        <GroupBox
            Header="{loc:Loc Bench.Context}"
            adonisExtensions:LayerExtension.Layer="3"
            Padding="10 5">
            <StackPanel x:Name="ContextPanel" />
        </GroupBox>

        <GroupBox
            Header="{loc:Loc Bench.Test}"
            adonisExtensions:LayerExtension.Layer="3"
            Padding="10 5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{loc:Loc Bench.Buffer}" VerticalAlignment="Center" Margin="0 0 8 0" />
                <!-- Measures to its widest item rather than a fixed width: the cache-bound tag is
                     appended at runtime and is longer in some languages, and a clipped warning is
                     the one thing this list must not produce. -->
                <ComboBox x:Name="BufferSize"
                          Grid.Column="1"
                          HorizontalAlignment="Left"
                          MinWidth="120"
                          VerticalAlignment="Center">
                    <ComboBoxItem Content="128 MB" Tag="128" />
                    <ComboBoxItem Content="256 MB" Tag="256" IsSelected="True" />
                    <ComboBoxItem Content="512 MB" Tag="512" />
                    <ComboBoxItem Content="1024 MB" Tag="1024" />
                </ComboBox>

                <Button x:Name="RunButton"
                        Grid.Column="2"
                        Content="{loc:Loc Bench.Run}"
                        Width="90"
                        Click="RunButton_Click"
                        Style="{DynamicResource {x:Static adonisUI:Styles.AccentButton}}"
                        xmlns:adonisUI="clr-namespace:AdonisUI;assembly=AdonisUI" />
            </Grid>
        </GroupBox>

        <GroupBox
            Header="{loc:Loc Bench.History}"
            adonisExtensions:LayerExtension.Layer="3"
            Padding="10 5">
            <StackPanel>
                <ListBox x:Name="HistoryList"
                         MaxHeight="200"
                         FontSize="11"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 6 0 0">
                    <Button x:Name="ExportButton"
                            Content="{loc:Loc Bench.ExportHtml}"
                            Width="100"
                            Margin="0 0 6 0"
                            IsEnabled="False"
                            Click="ExportButton_Click" />
                    <Button x:Name="PinButton"
                            Content="{loc:Loc Bench.Pin}"
                            Width="120"
                            IsEnabled="False"
                            Click="PinButton_Click" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <TextBlock x:Name="HintText"
                   FontSize="11"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="12 6 12 10"
                   Text="{loc:Loc Bench.Hint}" />
    </StackPanel>
    </ScrollViewer>
</local:ThemedAdonisWindow>
