<local:ThemedAdonisWindow
    xmlns:local="clr-namespace:ZenTimings"
    xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
    x:Class="ZenTimings.Windows.MemoryLatencyWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    mc:Ignorable="d"
    Title="Memory Benchmark"
    Width="430"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    BorderThickness="1"
    UseLayoutRounding="True"
    Style="{DynamicResource WindowStyles}"
    Icon="/ZenTimings;component/Resources/new-icon/16.png"
    Closing="Window_Closing">

    <StackPanel>
        <GroupBox
            Header="Result"
            adonisExtensions:LayerExtension.Layer="3"
            Padding="10 5">
            <StackPanel>
                <TextBlock x:Name="ResultText"
                           Text="-"
                           FontSize="30"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource AccentTextColor}" />
                <TextBlock x:Name="SpreadText"
                           Text="Not measured yet"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Opacity="0.7"
                           Margin="0 2 0 0" />

                <Grid Margin="0 8 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="Read" FontSize="11" Opacity="0.7" HorizontalAlignment="Center" />
                        <TextBlock x:Name="ReadText" Text="-" FontSize="15" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextColor}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="Write" FontSize="11" Opacity="0.7" HorizontalAlignment="Center" />
                        <TextBlock x:Name="WriteText" Text="-" FontSize="15" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextColor}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="Copy" FontSize="11" Opacity="0.7" HorizontalAlignment="Center" />
                        <TextBlock x:Name="CopyText" Text="-" FontSize="15" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextColor}" />
                    </StackPanel>
                </Grid>

                <ProgressBar x:Name="Progress"
                             Height="4"
                             Margin="0 8 0 0"
                             Minimum="0" Maximum="1"
                             Visibility="Hidden" />
            </StackPanel>
        </GroupBox>

        <GroupBox
            Header="Theoretical ceiling"
            adonisExtensions:LayerExtension.Layer="3"
            Padding="10 5">
            <StackPanel x:Name="CeilingPanel" />
        </GroupBox>

        <GroupBox
            Header="Configuration at the time of the run"
            adonisExtensions:LayerExtension.Layer="3"
            Padding="10 5">
            <StackPanel x:Name="ContextPanel" />
        </GroupBox>

        <GroupBox
            Header="Test"
            adonisExtensions:LayerExtension.Layer="3"
            Padding="10 5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Buffer" VerticalAlignment="Center" Margin="0 0 8 0" />
                <ComboBox x:Name="BufferSize"
                          Grid.Column="1"
                          HorizontalAlignment="Left"
                          Width="120"
                          VerticalAlignment="Center">
                    <ComboBoxItem Content="128 MB" Tag="128" />
                    <ComboBoxItem Content="256 MB" Tag="256" IsSelected="True" />
                    <ComboBoxItem Content="512 MB" Tag="512" />
                    <ComboBoxItem Content="1024 MB" Tag="1024" />
                </ComboBox>

                <Button x:Name="RunButton"
                        Grid.Column="2"
                        Content="Run"
                        Width="90"
                        Click="RunButton_Click"
                        Style="{DynamicResource {x:Static adonisUI:Styles.AccentButton}}"
                        xmlns:adonisUI="clr-namespace:AdonisUI;assembly=AdonisUI" />
            </Grid>
        </GroupBox>

        <TextBlock x:Name="HintText"
                   FontSize="11"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="12 6 12 10"
                   Text="Close other load first. Reads a few ns above AIDA64, which maps its buffer with large pages - use it to compare runs on this machine, not against other tools." />
    </StackPanel>
</local:ThemedAdonisWindow>
