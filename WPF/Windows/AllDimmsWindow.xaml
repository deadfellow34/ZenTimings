<local:ThemedAdonisWindow
    xmlns:local="clr-namespace:ZenTimings"
    x:Class="ZenTimings.Windows.AllDimmsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="clr-namespace:ZenTimings.Localization"
    mc:Ignorable="d"
    Title="{loc:Loc AllDimms.Title}"
    SizeToContent="WidthAndHeight"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner"
    BorderThickness="1"
    UseLayoutRounding="True"
    Style="{DynamicResource WindowStyles}"
    Icon="/ZenTimings;component/Resources/new-icon/16.png">

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <!-- Two per row: a pair sits side by side, four channels make a symmetric 2x2.
             The bottom-right margin leaves room for the scrollbars, which would otherwise
             sit on top of the last panel once the layout exceeds the window's maximum. -->
        <UniformGrid x:Name="ChannelsPanel" Columns="2" Margin="4 4 22 22" />
    </ScrollViewer>
</local:ThemedAdonisWindow>
